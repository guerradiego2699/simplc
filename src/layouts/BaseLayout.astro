---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { SITE, STORAGE_KEYS, type Locale } from '@/config/site';
import { getTranslator, locales, localizePath } from '@/i18n';

interface Props {
  locale: Locale;
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Locale-less path of this page, used for canonical and hreflang links. */
  path?: string;
  noindex?: boolean;
  /** Full-height application page (simulator): no footer, main fills the viewport. */
  app?: boolean;
}

const { locale, title, description, path = '/', noindex = false, app = false } = Astro.props;
const t = getTranslator(locale);

const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${t('meta.homeTitle')}`;
const metaDescription = description ?? t('meta.homeDescription');
const canonical = new URL(localizePath(locale, path), SITE.url).href;
const ogLocale = { es: 'es_CL', en: 'en_US' }[locale];
const ogImage = new URL('/og-image.png', SITE.url).href;
// Vercel sets VERCEL=1 during its builds; local and CI builds never load the analytics script.
const analytics = SITE.features.analytics && process.env['VERCEL'] === '1';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizePath(l, path), SITE.url).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {analytics && <script defer src="/_vercel/insights/script.js" />}

    <!-- Apply the saved theme before first paint to avoid a light/dark flash. -->
    <script is:inline define:vars={{ themeKey: STORAGE_KEYS.theme }}>
      try {
        const pref = localStorage.getItem(themeKey);
        if (pref === 'light' || pref === 'dark') document.documentElement.dataset.theme = pref;
      } catch {
        /* storage blocked: follow the OS preference */
      }
    </script>
  </head>
  <body
    class:list={[
      'flex flex-col',
      app ? 'min-h-screen lg:h-dvh lg:min-h-0 lg:overflow-hidden' : 'min-h-screen',
    ]}
  >
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-primary px-4 py-2 text-on-primary focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('a11y.skipToContent')}
    </a>
    <Header locale={locale} />
    <main id="main" class:list={['flex-1', { 'min-h-0': app }]}>
      <slot />
    </main>
    {!app && <Footer locale={locale} />}
  </body>
</html>
