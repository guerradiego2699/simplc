---
/**
 * Layout for Learn pages: course navigation (left), article, "On this page" index (right).
 * On smaller screens both navigations collapse into <details> blocks above the article.
 */
import type { MarkdownHeading } from 'astro';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Clock from '@lucide/astro/icons/clock';
import Languages from '@lucide/astro/icons/languages';
import '@/styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import { format, getTranslator, localizePath } from '@/i18n';
import type { Locale } from '@/config/site';
import type { LearnPage } from '@/lib/learn';

interface NavLink {
  href: string;
  title: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  groupTitle: string;
  minutes: number;
  reviewed: Date;
  headings: MarkdownHeading[];
  pages: LearnPage[];
  currentSlug: string;
  isFallback: boolean;
  prev: NavLink | undefined;
  next: NavLink | undefined;
}

const {
  locale,
  title,
  description,
  path,
  groupTitle,
  minutes,
  reviewed,
  headings,
  pages,
  currentSlug,
  isFallback,
  prev,
  next,
} = Astro.props;
const t = getTranslator(locale);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const reviewedText = format(t('learn.reviewed'), {
  date: reviewed.toLocaleDateString(locale === 'es' ? 'es-CL' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }),
});
---

<BaseLayout locale={locale} title={title} description={description} path={path}>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[220px_minmax(0,1fr)] lg:py-14 xl:grid-cols-[220px_minmax(0,1fr)_200px]">
    <!-- Course navigation -->
    <nav aria-label={t('learn.courseContents')} class="hidden lg:block">
      <div class="sticky top-24">
        <a
          href={localizePath(locale, '/learn')}
          class="text-xs font-semibold tracking-wider text-text uppercase no-underline hover:text-primary"
        >
          {t('learn.courseContents')}
        </a>
        <ol class="mt-3 space-y-0.5 border-l border-border">
          {pages.map((p, i) => (
            <li>
              <a
                href={localizePath(locale, `/learn/${p.slug}`)}
                aria-current={p.slug === currentSlug ? 'page' : undefined}
                class="-ml-px flex gap-2 border-l-2 border-transparent py-1.5 pl-3 text-sm text-text-muted no-underline hover:text-text aria-[current=page]:border-primary aria-[current=page]:font-medium aria-[current=page]:text-primary"
              >
                <span class="font-mono text-xs leading-5">{i + 1}.</span>
                {p.entry.data.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <article class="min-w-0">
      <!-- Compact navigation for small screens -->
      <div class="mb-8 space-y-2 lg:hidden">
        <details class="rounded-md border border-border bg-surface">
          <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium text-text">
            {t('learn.courseContents')}
          </summary>
          <ol class="border-t border-border px-4 py-2">
            {pages.map((p, i) => (
              <li>
                <a
                  href={localizePath(locale, `/learn/${p.slug}`)}
                  aria-current={p.slug === currentSlug ? 'page' : undefined}
                  class="block py-1.5 text-sm text-text-muted no-underline aria-[current=page]:font-medium aria-[current=page]:text-primary"
                >
                  {i + 1}. {p.entry.data.title}
                </a>
              </li>
            ))}
          </ol>
        </details>
        {toc.length > 0 && (
          <details class="rounded-md border border-border bg-surface xl:hidden">
            <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium text-text">
              {t('learn.onThisPage')}
            </summary>
            <ul class="border-t border-border px-4 py-2">
              {toc.map((h) => (
                <li class:list={[{ 'pl-4': h.depth === 3 }]}>
                  <a
                    href={`#${h.slug}`}
                    class="block py-1.5 text-sm text-text-muted no-underline hover:text-text"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>

      <header class="mb-10 border-b border-border pb-8">
        <p class="font-mono text-xs font-medium tracking-wider text-primary uppercase">
          {groupTitle}
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance text-text sm:text-4xl">
          {title}
        </h1>
        <p class="mt-4 text-lg text-pretty text-text-muted">{description}</p>
        <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-text-muted">
          <span class="inline-flex items-center gap-1.5">
            <Clock size={14} aria-hidden="true" />
            {format(t('learn.readingTime'), { n: minutes })}
          </span>
          <span>{reviewedText}</span>
        </p>
        {isFallback && (
          <p class="mt-5 flex items-start gap-2 rounded-md border border-warning/50 bg-warning/10 px-4 py-3 text-sm text-text">
            <Languages size={16} class="mt-0.5 shrink-0 text-warning" aria-hidden="true" />
            {t('learn.fallbackNotice')}
          </p>
        )}
      </header>

      <div class="prose max-w-[72ch]" lang={isFallback ? 'es' : undefined}>
        <slot />
      </div>

      <!-- Previous / next -->
      <nav
        aria-label={`${t('learn.previous')} / ${t('learn.next')}`}
        class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2"
      >
        {prev ? (
          <a
            href={prev.href}
            class="group rounded-lg border border-border p-4 no-underline hover:border-primary"
          >
            <span class="flex items-center gap-1 text-xs text-text-muted">
              <ArrowLeft size={14} aria-hidden="true" />
              {t('learn.previous')}
            </span>
            <span class="mt-1 block font-medium text-text group-hover:text-primary">
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={next.href}
            class="group rounded-lg border border-border p-4 text-right no-underline hover:border-primary"
          >
            <span class="flex items-center justify-end gap-1 text-xs text-text-muted">
              {t('learn.next')}
              <ArrowRight size={14} aria-hidden="true" />
            </span>
            <span class="mt-1 block font-medium text-text group-hover:text-primary">
              {next.title}
            </span>
          </a>
        )}
      </nav>
    </article>

    <!-- On this page -->
    {toc.length > 0 && (
      <nav aria-label={t('learn.onThisPage')} class="hidden xl:block">
        <div class="sticky top-24">
          <p class="text-xs font-semibold tracking-wider text-text uppercase">
            {t('learn.onThisPage')}
          </p>
          <ul class="mt-3 space-y-1.5" data-toc>
            {toc.map((h) => (
              <li class:list={[{ 'pl-3': h.depth === 3 }]}>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="block text-sm text-text-muted no-underline hover:text-text data-[active]:font-medium data-[active]:text-primary"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  // Highlight the section currently in view in the "On this page" index.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => {
    links.set(a.dataset['tocLink'] ?? '', a);
  });

  if (links.size > 0 && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      links.forEach((a, key) => a.toggleAttribute('data-active', key === id));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        const first = visible[0];
        if (first) setActive(first.target.id);
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    });
  }
</script>
