{
  "name": "st",
  "scopeName": "source.st",
  "displayName": "Structured Text (IEC 61131-3)",
  "aliases": ["iec-st"],
  "repository": {},
  "patterns": [
    { "name": "comment.block.st", "begin": "\\(\\*", "end": "\\*\\)" },
    { "name": "comment.block.c.st", "begin": "/\\*", "end": "\\*/" },
    { "name": "comment.line.double-slash.st", "match": "//.*$" },
    { "name": "constant.other.time.st", "match": "(?i)\\b(?:T|TIME)#-?[0-9a-z_.]+" },
    {
      "name": "keyword.control.st",
      "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|RETURN)\\b"
    },
    {
      "name": "keyword.other.st",
      "match": "(?i)\\b(PROGRAM|END_PROGRAM|VAR|END_VAR|VAR_INPUT|VAR_OUTPUT|FUNCTION_BLOCK|END_FUNCTION_BLOCK)\\b"
    },
    { "name": "keyword.operator.word.st", "match": "(?i)\\b(AND|OR|XOR|NOT|MOD)\\b" },
    { "name": "constant.language.st", "match": "(?i)\\b(TRUE|FALSE)\\b" },
    {
      "name": "storage.type.st",
      "match": "(?i)\\b(BOOL|INT|DINT|REAL|LREAL|TIME|TON|TOF|TP|CTU|CTD|CTUD|R_TRIG|F_TRIG)\\b"
    }
  ]
}
