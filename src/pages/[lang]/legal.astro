---
import type { GetStaticPaths } from 'astro';
import { adsEnabled, SITE, type Locale } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { format, getDictionary, locales } from '@/i18n';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

/** Bump when the text changes. */
const LEGAL_UPDATED = '2026-10-05';

const locale = Astro.params.lang as Locale;
const l = getDictionary(locale).legal;
const site = (text: string) => format(text, { site: SITE.name });
const date = new Date(`${LEGAL_UPDATED}T12:00:00Z`).toLocaleDateString(
  locale === 'es' ? 'es-CL' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric' },
);
const sections = Object.entries(l.sections);
const ads = adsEnabled();
---

<BaseLayout locale={locale} title={l.title} description={site(l.description)} path="/legal">
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">{l.title}</h1>
    <p class="mt-3 text-sm text-text-muted">{format(l.updated, { date })}</p>
    {sections.map(([id, section]) => (
      <section class="mt-10" id={id}>
        <h2 class="text-xl font-semibold text-text">{section.title}</h2>
        <div class="mt-3 flex flex-col gap-3 text-text-muted">
          {section.body.map((p) => (
            <p>{site(p)}</p>
          ))}
          {id === 'privacy' && !ads && <p>{l.adsOff}</p>}
        </div>
        {id === 'contact' && (
          <a href={`${SITE.repoUrl}/issues`} rel="noopener" class="mt-2 inline-block text-primary">
            {`${SITE.repoUrl}/issues`}
          </a>
        )}
      </section>
    ))}
    {ads && (
      <section class="mt-10" id="ads">
        <h2 class="text-xl font-semibold text-text">{l.adsOn.title}</h2>
        <div class="mt-3 flex flex-col gap-3 text-text-muted">
          {l.adsOn.body.map((p) => (
            <p>{p}</p>
          ))}
          <p>
            <button type="button" data-cookie-preferences class="text-primary hover:underline">
              {getDictionary(locale).ads.preferences}
            </button>
          </p>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
