---
import type { GetStaticPaths } from 'astro';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Monitor from '@lucide/astro/icons/monitor';
import Play from '@lucide/astro/icons/play';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { format, getDictionary, getTranslator, locales, localizePath } from '@/i18n';
import { CHALLENGES } from '@/simulator/challenges';
import type { Locale } from '@/config/site';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = getTranslator(locale);
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  title={t('challenges.indexTitle')}
  description={t('challenges.indexDescription')}
  path="/challenges"
>
  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">
      {t('challenges.indexTitle')}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-text-muted">{t('challenges.intro')}</p>
    <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-text-muted">
      <span
        id="challenge-progress"
        class="font-semibold text-text"
        data-template={t('challenges.progress')}
        data-total={CHALLENGES.length}
      >
        {format(t('challenges.progress'), { done: 0, total: CHALLENGES.length })}
      </span>
      <span>{t('challenges.privacy')}</span>
    </p>
    <p class="mt-4 flex items-center gap-2 text-sm text-text-muted lg:hidden">
      <Monitor size={16} aria-hidden="true" class="shrink-0" />
      {t('challenges.desktopNote')}
    </p>

    <ol class="mt-10 flex flex-col gap-4">
      {CHALLENGES.map((challenge) => (
        <li
          class="rounded-lg border border-border bg-bg p-5 data-[completed]:border-primary/60"
          data-challenge={challenge.id}
        >
          <div class="flex flex-wrap items-center gap-3 text-xs text-text-muted">
            <span class="font-mono font-semibold text-primary">
              {String(challenge.order).padStart(2, '0')}
            </span>
            <span
              class="rounded-full border border-border px-2 py-0.5"
              title={t('challenges.levelLabel')}
            >
              {format(t('challenges.level'), { n: challenge.level })}
            </span>
            <span>{format(t('challenges.tests'), { n: challenge.tests.length })}</span>
            {challenge.plant && (
              <span>
                {format(t('challenges.plant'), {
                  name: dict.simulator.plant.names[challenge.plant],
                })}
              </span>
            )}
            <span
              hidden
              data-completed-badge
              class="inline-flex items-center gap-1 rounded-full border border-primary px-2 py-0.5 font-medium text-primary"
            >
              <CircleCheck size={12} aria-hidden="true" />
              {t('challenges.completed')}
            </span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-text">{challenge.title[locale]}</h2>
          <div class="mt-2 flex flex-col gap-2 text-sm text-text-muted">
            {challenge.statement[locale].map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <a
            href={`${localizePath(locale, '/simulator')}?challenge=${challenge.id}`}
            class="mt-4 hidden h-9 items-center gap-1.5 rounded-md bg-primary px-3 text-sm font-semibold text-on-primary no-underline hover:bg-primary-hover lg:inline-flex"
          >
            <Play size={15} aria-hidden="true" />
            {t('challenges.solve')}
          </a>
        </li>
      ))}
    </ol>
    <p class="mt-8 text-sm text-text-muted">{t('challenges.moreSoon')}</p>
  </div>
</BaseLayout>

<script>
  import { loadProgress } from '@/simulator/challenges/progress';

  const { completed } = loadProgress();
  let done = 0;
  for (const card of document.querySelectorAll<HTMLElement>('[data-challenge]')) {
    if (!completed[card.dataset['challenge'] ?? '']) continue;
    done++;
    card.dataset['completed'] = '';
    card.querySelector<HTMLElement>('[data-completed-badge]')?.removeAttribute('hidden');
  }
  const progress = document.getElementById('challenge-progress');
  if (progress) {
    progress.textContent = (progress.dataset['template'] ?? '')
      .replace('{done}', String(done))
      .replace('{total}', progress.dataset['total'] ?? '');
  }
</script>
