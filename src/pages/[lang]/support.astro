---
import type { GetStaticPaths } from 'astro';
import Coffee from '@lucide/astro/icons/coffee';
import ExternalLink from '@lucide/astro/icons/external-link';
import Heart from '@lucide/astro/icons/heart';
import { SITE, type Locale } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { format, getDictionary, getTranslator, locales } from '@/i18n';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = getTranslator(locale);
const s = getDictionary(locale).support;
const site = (text: string) => format(text, { site: SITE.name });

// Only configured links are shown (SITE.donations; empty string = hidden).
const donations = (
  [
    { key: 'koFi', label: s.koFi, Icon: Heart },
    { key: 'buyMeACoffee', label: s.buyMeACoffee, Icon: Coffee },
    { key: 'mercadoPago', label: s.mercadoPago, Icon: Heart },
  ] as const
)
  .map((d) => ({ ...d, url: SITE.donations[d.key] as string }))
  .filter((d) => d.url !== '');
---

<BaseLayout locale={locale} title={s.title} description={site(s.description)} path="/support">
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">{s.title}</h1>
    <p class="mt-4 text-lg text-text-muted">{site(s.intro)}</p>

    <section class="mt-10 rounded-lg border border-border bg-surface p-6">
      <h2 class="text-xl font-semibold text-text">{s.donateTitle}</h2>
      <p class="mt-2 text-text-muted">{s.donateBody}</p>
      {donations.length > 0 ? (
        <>
          <ul class="mt-5 flex flex-wrap gap-3" data-donations>
            {donations.map(({ key, label, url, Icon }) => (
              <li>
                <a
                  href={url}
                  rel="noopener noreferrer"
                  target="_blank"
                  data-donation={key}
                  class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-4 text-sm font-semibold text-on-primary no-underline hover:bg-primary-hover"
                >
                  <Icon size={16} aria-hidden="true" />
                  {label}
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-xs text-text-muted">{s.external}</p>
        </>
      ) : (
        <p class="mt-5 font-medium text-text" data-donations-soon>
          {s.noLinks}
        </p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-text">{s.otherTitle}</h2>
      <ul class="mt-3 flex list-disc flex-col gap-2 pl-5 text-text-muted">
        {s.other.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <a
        href={SITE.repoUrl}
        rel="noopener"
        class="mt-5 inline-flex h-10 items-center gap-2 rounded-md border border-border px-4 text-sm font-medium text-text no-underline hover:border-primary hover:text-primary"
      >
        {t('support.repo')}
        <ExternalLink size={14} aria-hidden="true" />
      </a>
    </section>
  </div>
</BaseLayout>
