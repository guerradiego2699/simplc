---
import type { GetStaticPaths } from 'astro';
import Monitor from '@lucide/astro/icons/monitor';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SimulatorApp from '@/simulator/ui/SimulatorApp';
import { getDictionary, getTranslator, locales, localizePath } from '@/i18n';
import type { Locale } from '@/config/site';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = getTranslator(locale);
const strings = getDictionary(locale).simulator;
---

<BaseLayout
  locale={locale}
  title={t('simulator.metaTitle')}
  description={t('simulator.metaDescription')}
  path="/simulator"
  app
>
  <!-- Phones and tablets: the simulator is desktop-only (spec 5.4). -->
  <div class="mx-auto max-w-lg px-4 py-20 text-center lg:hidden">
    <span class="inline-flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary">
      <Monitor size={24} aria-hidden="true" />
    </span>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight text-text">
      {t('simulator.desktopOnly.title')}
    </h1>
    <p class="mt-3 text-text-muted">{t('simulator.desktopOnly.body')}</p>
    <a
      href={localizePath(locale, '/learn')}
      class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-on-primary no-underline hover:bg-primary-hover"
    >
      {t('simulator.desktopOnly.cta')}
    </a>
  </div>

  <div class="hidden h-full lg:block">
    <h1 class="sr-only">{t('simulator.metaTitle')}</h1>
    <SimulatorApp client:only="react" strings={strings} locale={locale}>
      <div slot="fallback" class="flex h-full items-center justify-center text-sm text-text-muted">
        {t('simulator.loading')}
      </div>
    </SimulatorApp>
  </div>
</BaseLayout>
