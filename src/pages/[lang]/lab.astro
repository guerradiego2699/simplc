---
import type { GetStaticPaths } from 'astro';
import type { Locale } from '@/config/site';
import LabApp from '@/components/lab/LabApp';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDictionary, locales } from '@/i18n';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const s = getDictionary(locale).lab;
---

<!-- Private section: access is checked by the Vercel functions in api/lab/ (not in this page). -->
<BaseLayout locale={locale} title={s.title} description={s.description} path="/lab" noindex>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">{s.heading}</h1>
    <p class="mt-3 max-w-3xl text-text-muted">{s.intro}</p>
    <LabApp client:load strings={s} />
  </div>
</BaseLayout>
