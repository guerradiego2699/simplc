---
import type { GetStaticPaths } from 'astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Play from '@lucide/astro/icons/play';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { format, getDictionary, getTranslator, locales, localizePath } from '@/i18n';
import { EXAMPLES } from '@/simulator/examples';
import type { Locale } from '@/config/site';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = getTranslator(locale);
const dict = getDictionary(locale);
const upcoming = dict.examples.upcoming as Record<string, string>;

// The full list from the spec (section 7): built examples plus the ones still to come.
const entries = Array.from({ length: 14 }, (_, i) => i + 1).map((order) => ({
  order,
  example: EXAMPLES.find((e) => e.order === order),
  upcoming: upcoming[String(order)],
}));
---

<BaseLayout
  locale={locale}
  title={t('examples.indexTitle')}
  description={t('examples.indexDescription')}
  path="/examples"
>
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">
      {t('examples.indexTitle')}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-text-muted">{t('examples.intro')}</p>

    <ol class="mt-12 grid gap-4 sm:grid-cols-2">
      {entries.map(({ order, example, upcoming }) =>
        example ? (
          <li
            class="flex flex-col rounded-lg border border-border bg-bg p-5"
            data-example={example.id}
          >
            <div class="flex items-center gap-3 text-xs text-text-muted">
              <span class="font-mono font-semibold text-primary">
                {String(order).padStart(2, '0')}
              </span>
              <span
                class="rounded-full border border-border px-2 py-0.5"
                title={t('examples.levelLabel')}
              >
                {format(t('examples.level'), { n: example.level })}
              </span>
              {example.plant && (
                <span>
                  {t('examples.plant')}: {dict.simulator.plant.names[example.plant]}
                </span>
              )}
            </div>
            <h2 class="mt-3 text-lg font-semibold text-text">
              <a
                href={localizePath(locale, `/examples/${example.id}`)}
                class="text-text no-underline hover:text-primary"
              >
                {example.title[locale]}
              </a>
            </h2>
            <p class="mt-2 flex-1 text-sm text-text-muted">{example.summary[locale]}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a
                href={localizePath(locale, `/examples/${example.id}`)}
                class="inline-flex h-9 items-center gap-1.5 rounded-md border border-border px-3 text-sm font-medium text-text no-underline hover:border-primary hover:text-primary"
              >
                {t('examples.details')}
                <ArrowRight size={15} aria-hidden="true" />
              </a>
              <a
                href={`${localizePath(locale, '/simulator')}?example=${example.id}`}
                class="hidden h-9 items-center gap-1.5 rounded-md bg-primary px-3 text-sm font-semibold text-on-primary no-underline hover:bg-primary-hover lg:inline-flex"
              >
                <Play size={15} aria-hidden="true" />
                {t('examples.open')}
              </a>
            </div>
          </li>
        ) : (
          <li class="flex items-center gap-3 rounded-lg border border-dashed border-border p-5 text-sm text-text-muted">
            <span class="font-mono">{String(order).padStart(2, '0')}</span>
            <span class="flex-1">{upcoming}</span>
            <span class="rounded-full border border-border px-2 py-0.5 text-xs">
              {t('examples.comingSoon')}
            </span>
          </li>
        ),
      )}
    </ol>
  </div>
</BaseLayout>
