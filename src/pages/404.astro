---
/**
 * Static 404: the host serves it for any unknown URL, so it cannot know the locale at build
 * time. It is rendered in Spanish with an English line, and a tiny script switches the
 * "home" link to /en/ when the missing URL was under /en/.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTranslator, localizePath } from '@/i18n';
import { SITE } from '@/config/site';

const t = getTranslator(SITE.defaultLocale);
const tEn = getTranslator('en');
---

<BaseLayout locale={SITE.defaultLocale} title={t('notFound.title')} noindex>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm font-semibold text-danger">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-text sm:text-4xl">
      {t('notFound.title')}
    </h1>
    <p class="mt-4 text-text-muted">{t('notFound.body')}</p>
    <p class="mt-1 text-sm text-text-muted" lang="en">
      {tEn('notFound.title')} — {tEn('notFound.body')}
    </p>
    <a
      href={localizePath(SITE.defaultLocale)}
      data-home-link
      class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-on-primary no-underline hover:bg-primary-hover"
    >
      {t('notFound.back')}
    </a>
  </div>
</BaseLayout>

<script>
  import { localizePath, parsePath } from '@/i18n';

  const { locale } = parsePath(location.pathname);
  const link = document.querySelector<HTMLAnchorElement>('[data-home-link]');
  if (locale && link) link.href = localizePath(locale);
</script>
