---
/**
 * The same program — start/stop with seal-in — in the five IEC 61131-3 languages, as tabs.
 * <LanguageTabs /> in MDX. Plain Astro + a small script (no React).
 */
import { getDictionary, localeFromUrl } from '@/i18n';
import { StaticLadder } from '@/simulator/languages/ladder/editor/StaticLadder';
import { StaticFbd } from '@/simulator/languages/fbd/editor/StaticFbd';
import { coil, contact, parallel, rung, series } from '@/simulator/languages/ladder/model';

const locale = localeFromUrl(Astro.url);
const dict = getDictionary(locale);
const s = dict.widgets.languages;
const fbdNetwork = dict.simulator.fbd.network.replace('{n}', '1');
const { start, stop, motor } = s.vars;
const id = 'lang-tabs';

const program = {
  rungs: [
    rung(
      [
        parallel(series([contact('NO', start)]), series([contact('NO', motor)])),
        contact('NO', stop),
      ],
      [coil('coil', motor)],
    ),
  ],
};
const tags = [
  { id: 't1', name: start, address: 'I0.0', comment: '' },
  { id: 't2', name: stop, address: 'I0.1', comment: '' },
  { id: 't3', name: motor, address: 'Q0.0', comment: '' },
];

const st = `${motor} := (${start} OR ${motor}) AND ${stop};`;
const il = [`LD   ${start}`, `OR   ${motor}`, `AND  ${stop}`, `ST   ${motor}`].join('\n');

const TABS = ['LD', 'FBD', 'ST', 'IL', 'SFC'] as const;
const mono = 'font-family: var(--ff-mono); font-size: 12px;';
---

<figure class="not-prose my-8 rounded-lg border border-border bg-surface p-4 sm:p-6" data-lang-tabs>
  <p class="mb-3 text-sm text-text-muted">{s.intro}</p>
  <div role="tablist" aria-label={s.label} class="flex flex-wrap gap-1 border-b border-border">
    {TABS.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${tab}`}
        aria-controls={`${id}-panel-${tab}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="-mb-px rounded-t-md border border-transparent px-3 py-1.5 font-mono text-sm font-semibold text-text-muted hover:text-text aria-selected:border-border aria-selected:border-b-surface aria-selected:bg-surface aria-selected:text-primary"
        title={s.names[tab]}
      >
        {tab}
      </button>
    ))}
  </div>

  {TABS.map((tab, i) => (
    <div
      role="tabpanel"
      id={`${id}-panel-${tab}`}
      aria-labelledby={`${id}-tab-${tab}`}
      hidden={i !== 0}
      class="pt-4"
      data-panel={tab}
    >
      <p class="mb-3 text-sm font-semibold text-text">{s.names[tab]}</p>
      {tab === 'LD' && <StaticLadder program={program} tags={tags} rungLabel={() => s.network} />}
      {tab === 'FBD' && <StaticFbd program={program} tags={tags} networkLabel={() => fbdNetwork} />}
      {tab ===
        'ST' && <pre class="overflow-x-auto rounded-md border border-border bg-bg p-4 font-mono text-sm text-text">{st}</pre>}
      {tab ===
        'IL' && <pre class="overflow-x-auto rounded-md border border-border bg-bg p-4 font-mono text-sm text-text">{il}</pre>}
      {tab === 'SFC' && (
        <div class="overflow-x-auto rounded-md border border-border bg-bg p-2">
          <svg
            viewBox="0 0 520 300"
            width="520"
            height="300"
            class="block max-w-none"
            role="img"
            aria-label={s.names.SFC}
          >
            <g stroke="var(--wire-off)" stroke-width="2" fill="none">
              <path d="M120 20 V40" />
              <path d="M120 80 V140" />
              <path d="M120 180 V240 H60 V20 H120" />
              <path d="M170 160 H230" />
            </g>
            <rect
              x="80"
              y="40"
              width="80"
              height="40"
              fill="var(--bg)"
              stroke="var(--text)"
              stroke-width="1.5"
            />
            <rect
              x="84"
              y="44"
              width="72"
              height="32"
              fill="none"
              stroke="var(--text)"
              stroke-width="1"
            />
            <text x="120" y="65" text-anchor="middle" fill="var(--text)" style={mono}>
              S0
            </text>
            <line x1="105" y1="110" x2="135" y2="110" stroke="var(--text)" stroke-width="2.5" />
            <text x="145" y="114" fill="var(--text)" style={mono}>
              {start} AND {stop}
            </text>
            <rect
              x="80"
              y="140"
              width="80"
              height="40"
              fill="var(--bg)"
              stroke="var(--text)"
              stroke-width="1.5"
            />
            <text x="120" y="165" text-anchor="middle" fill="var(--text)" style={mono}>
              S1
            </text>
            <rect
              x="230"
              y="145"
              width="30"
              height="30"
              fill="var(--bg)"
              stroke="var(--text)"
              stroke-width="1.5"
            />
            <text x="245" y="165" text-anchor="middle" fill="var(--text)" style={mono}>
              N
            </text>
            <rect
              x="260"
              y="145"
              width="110"
              height="30"
              fill="var(--bg)"
              stroke="var(--text)"
              stroke-width="1.5"
            />
            <text x="315" y="165" text-anchor="middle" fill="var(--text)" style={mono}>
              {motor}
            </text>
            <line x1="105" y1="210" x2="135" y2="210" stroke="var(--text)" stroke-width="2.5" />
            <text x="145" y="214" fill="var(--text)" style={mono}>
              NOT {stop}
            </text>
            <text x="170" y="64" fill="var(--text-muted)" style={mono}>
              {s.stepStopped}
            </text>
          </svg>
        </div>
      )}
      <p class="mt-3 text-sm text-text-muted">{s.notes[tab]}</p>
    </div>
  ))}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-lang-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        e.preventDefault();
        const next = (i + delta + tabs.length) % tabs.length;
        select(next);
        tabs[next]?.focus();
      });
    });
  }
</script>
