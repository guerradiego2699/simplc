---
/**
 * Block diagram of a PLC: field inputs → input module → CPU (program + data memory) →
 * output module → actuators, with power supply and communications.
 * Built with HTML/CSS so it stacks vertically on phones instead of shrinking.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowDown from '@lucide/astro/icons/arrow-down';
import Zap from '@lucide/astro/icons/zap';
import Network from '@lucide/astro/icons/network';
import { getTranslator, localeFromUrl } from '@/i18n';

const t = getTranslator(localeFromUrl(Astro.url));

const box =
  'rounded-md border border-border bg-bg px-3 py-3 text-center text-sm font-medium text-text';
const field =
  'rounded-md border border-dashed border-border px-3 py-3 text-center text-sm text-text-muted';
---

<figure class="not-prose my-8 rounded-lg border border-border bg-surface p-4 sm:p-6">
  <div role="img" aria-label={t('widgets.plcBlock.label')}>
    <div class="mb-3 flex justify-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-bg px-3 py-1 text-xs text-text-muted">
        <Network size={14} aria-hidden="true" />
        {t('widgets.plcBlock.comms')}
      </span>
    </div>

    <div class="flex flex-col items-stretch gap-2 md:flex-row md:items-center">
      <div class:list={[field, 'md:flex-1']}>{t('widgets.plcBlock.sensors')}</div>
      <span class="self-center text-text-muted">
        <ArrowDown size={18} class="md:hidden" aria-hidden="true" />
        <ArrowRight size={18} class="hidden md:block" aria-hidden="true" />
      </span>
      <div class:list={[box, 'md:flex-1']}>{t('widgets.plcBlock.inputs')}</div>
      <span class="self-center text-text-muted">
        <ArrowDown size={18} class="md:hidden" aria-hidden="true" />
        <ArrowRight size={18} class="hidden md:block" aria-hidden="true" />
      </span>
      <div class="rounded-md border-2 border-primary bg-bg p-3 md:flex-[1.4]">
        <p class="text-center font-mono text-sm font-semibold text-primary">
          {t('widgets.plcBlock.cpu')}
        </p>
        <div class="mt-2 grid gap-2 text-xs">
          <span class="rounded bg-surface-2 px-2 py-1.5 text-center text-text">
            {t('widgets.plcBlock.program')}
          </span>
          <span class="rounded bg-surface-2 px-2 py-1.5 text-center text-text">
            {t('widgets.plcBlock.data')}
          </span>
        </div>
      </div>
      <span class="self-center text-text-muted">
        <ArrowDown size={18} class="md:hidden" aria-hidden="true" />
        <ArrowRight size={18} class="hidden md:block" aria-hidden="true" />
      </span>
      <div class:list={[box, 'md:flex-1']}>{t('widgets.plcBlock.outputs')}</div>
      <span class="self-center text-text-muted">
        <ArrowDown size={18} class="md:hidden" aria-hidden="true" />
        <ArrowRight size={18} class="hidden md:block" aria-hidden="true" />
      </span>
      <div class:list={[field, 'md:flex-1']}>{t('widgets.plcBlock.actuators')}</div>
    </div>

    <div class="mt-3 flex justify-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-warning/50 bg-bg px-3 py-1 text-xs text-text">
        <Zap size={14} class="text-warning" aria-hidden="true" />
        {t('widgets.plcBlock.psu')}
      </span>
    </div>
  </div>
</figure>
