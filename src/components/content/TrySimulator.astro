---
/** "Try it in the simulator" card. <TrySimulator example="motor-start-stop" /> */
import Play from '@lucide/astro/icons/play';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { getTranslator, localeFromUrl, localizePath } from '@/i18n';

interface Props {
  /** Example id the simulator will preload (examples arrive in Phase 7). */
  example: string;
}

const { example } = Astro.props;
const locale = localeFromUrl(Astro.url);
const t = getTranslator(locale);
const href = `${localizePath(locale, '/simulator')}?example=${encodeURIComponent(example)}`;
---

<a
  href={href}
  class="not-prose group my-7 flex items-center gap-4 rounded-lg border border-border bg-bg p-4 no-underline transition-colors hover:border-primary"
>
  <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-md bg-primary text-on-primary">
    <Play size={18} aria-hidden="true" />
  </span>
  <span class="flex-1">
    <span class="block font-semibold text-text">{t('learn.trySimulator.title')}</span>
    <span class="block text-sm text-text-muted">{t('learn.trySimulator.body')}</span>
  </span>
  <ArrowRight
    size={18}
    aria-hidden="true"
    class="text-primary transition-transform group-hover:translate-x-0.5"
  />
</a>
