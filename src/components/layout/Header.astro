---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { MAIN_NAV } from '@/config/navigation';
import { getTranslator, localizePath, parsePath } from '@/i18n';
import type { Locale } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const currentPath = parsePath(Astro.url.pathname).path;

const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <Logo href={localizePath(locale)} label={t('a11y.home')} />

    <nav aria-label={t('a11y.mainNav')} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {MAIN_NAV.map((item) => (
          <li>
            <a
              href={localizePath(locale, item.path)}
              aria-current={isActive(item.path) ? 'page' : undefined}
              class="rounded-md px-3 py-2 text-sm font-medium text-text-muted no-underline transition-colors hover:bg-surface hover:text-text aria-[current=page]:text-primary"
            >
              {t(item.label)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-2 lg:flex">
      <LanguageSwitcher locale={locale} />
      <ThemeSwitcher locale={locale} />
    </div>

    <button
      type="button"
      class="ml-auto inline-flex size-10 items-center justify-center rounded-md text-text hover:bg-surface lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t('a11y.openMenu')}
      data-menu-toggle
      data-label-open={t('a11y.openMenu')}
      data-label-close={t('a11y.closeMenu')}
    >
      <Menu size={22} aria-hidden="true" data-icon-open />
      <X size={22} aria-hidden="true" data-icon-close class="hidden" />
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-border bg-bg lg:hidden">
    <nav aria-label={t('a11y.mainNav')} class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      <ul class="flex flex-col">
        {MAIN_NAV.map((item) => (
          <li>
            <a
              href={localizePath(locale, item.path)}
              aria-current={isActive(item.path) ? 'page' : undefined}
              class="block rounded-md px-3 py-3 text-base font-medium text-text no-underline hover:bg-surface aria-[current=page]:text-primary"
            >
              {t(item.label)}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-3 flex items-center justify-between gap-3 border-t border-border px-3 pt-4 pb-2">
        <LanguageSwitcher locale={locale} />
        <ThemeSwitcher locale={locale} />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute(
      'aria-label',
      (open ? toggle.dataset['labelClose'] : toggle.dataset['labelOpen']) ?? '',
    );
    toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setOpen(menu?.hidden === true));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
